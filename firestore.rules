rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // users/{uid}
    // ---------------------------------------------------------------
    // Any signed-in user can read any profile (needed for chat list
    // display names/photos and handle search). Only the owner can
    // create or edit their own doc.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid;
      allow update: if request.auth != null
                    && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // chats/{chatId}
    // ---------------------------------------------------------------
    // Only the two (or more) participants can read or write a chat
    // document. Creation must include the creator's own uid in
    // participants.
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      allow delete: if false;

      // -------------------------------------------------------------
      // chats/{chatId}/messages/{messageId}
      // -------------------------------------------------------------
      // Only participants of the parent chat can read messages.
      // A message can only be created by the participant sending it,
      // as themselves (senderId must match their own uid), and
      // messages are immutable afterwards (no update/delete).
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.senderId == request.auth.uid;

        allow update: if false;
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // calls/{callId}
    // ---------------------------------------------------------------
    // Only the caller and callee can read/write a call doc. Creation
    // must have the creator as the caller (they're the one starting it).
    // Updates are restricted to either party (accept/decline/end/answer).
    match /calls/{callId} {
      allow read: if request.auth != null
                  && request.auth.uid in [resource.data.callerId, resource.data.calleeId];

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.callerId;

      allow update: if request.auth != null
                    && request.auth.uid in [resource.data.callerId, resource.data.calleeId]
                    && request.resource.data.status in ['ringing', 'accepted', 'declined', 'ended']
                    && (
                      // caller may concede the call to the callee by setting answer
                      // only from the callee side; the caller is not allowed to write answer.
                      request.auth.uid == resource.data.callerId
                        ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer'])
                    );

      allow delete: if false;

      // ICE candidates: each side writes only to its own collection.
      match /callerCandidates/{candidateId} {
        allow read: if request.auth != null
                    && request.auth.uid in [
                         get(/databases/$(database)/documents/calls/$(callId)).data.callerId,
                         get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
                       ];
        allow create: if request.auth != null
                    && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if request.auth != null
                    && request.auth.uid in [
                         get(/databases/$(database)/documents/calls/$(callId)).data.callerId,
                         get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
                       ];
        allow create: if request.auth != null
                    && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId;
        allow update, delete: if false;
      }
    }
  }
}